{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "whim",
      "camelcase": "Whim",
      "title": "Whim",
      "scope": "source.whim",
      "file-types": [
        "whim"
      ],
      "injection-regex": "^whim$",
      "class-name": "TreeSitterWhim",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Tree-sitter grammar for Whim",
    "authors": [
      {
        "name": "Seifeddine Gmati",
        "email": "azjezz@carthage.software",
        "url": "https://github.com/azjezz"
      }
    ],
    "links": {
      "repository": "https://github.com/carthage-software/tree-sitter-whim"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
